DEVICE_ID=your-tidbyt-device-id
TIDBYT_API_TOKEN=your-tidbyt-api-token
PIXLET_VERSION=0.34.0
BASE_IMAGE=ubuntu:24.04

# Used by the daemon and one-shot render. Preview settings are in its browser UI.
PROMETHEUS_URL=http://192.168.1.234:30500
POLL_INTERVAL_SECONDS=30
RETRY_INTERVAL_SECONDS=90
COMMAND_TIMEOUT_SECONDS=30

# Optional: set to your expected number of power series to detect partial totals.
# The review observed 5; leave 0 to allow the count to change.
EXPECTED_GPU_COUNT=0

# Optional override; by default derived from poll/retry/timeout settings.
# HEALTH_MAX_AGE_SECONDS=270
